# ─── MANDATORY SECURITY ──────────────────────────────────────────
# Your app will CRASH if this is missing 
DJANGO_SECRET_KEY=your-super-secret-key-here

# ─── DATABASE CONFIGURATION ──────────────────────────────────────
# Required for PostgreSQL connection
DB_NAME=acetheentrance
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ─── ENVIRONMENT & DEBUG ─────────────────────────────────────────
# Options: "development" or "production"
DJANGO_ENVIRONMENT=development
# Set to "True" for dev, "False" for production
DJANGO_DEBUG=True
# Space-separated list of hosts
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 acetheentrance.com

# ─── INFRASTRUCTURE (DOCKER SPECIFIC) ────────────────────────────
# These are used by the Postgres Docker Image (not Django directly)
POSTGRES_DB=acetheentrance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password

# Used for automated superuser creation in Docker entrypoints
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin_password_here

# ─── CACHING & REDIS ─────────────────────────────────────────────
# Optional: Defaults to the string 'os.getenv...' in your settings (check your code logic)
REDIS_URL=redis://localhost:6379/1

# ─── GOOGLE OAUTH (ALLAUTH) ──────────────────────────────────────
# Required if you want Google Login to work
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── EMAIL (PRODUCTION ONLY) ─────────────────────────────────────
# Required only if DJANGO_ENVIRONMENT=production
RESEND_API_KEY=re_your_api_key

